{
  "name": "seia-comunidades",
  "version": "0.1.0",
  "description": "Plataforma de inteligencia territorial para procesos PAC del SEIA",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n astro,electron -c cyan,magenta \"pnpm dev:astro\" \"pnpm dev:electron\"",
    "dev:astro": "astro dev",
    "dev:electron": "wait-on http://127.0.0.1:4321 && electron .",
    "start": "cross-env SEIA_USE_DIST=1 electron .",
    "build": "pnpm build:electron && pnpm build:astro",
    "build:astro": "astro build",
    "build:electron": "tsup",
    "package": "pnpm build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/capture-fixtures.ts",
    "sync": "tsx scripts/sync.ts",
    "index:rebuild": "tsx scripts/rebuild-index.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "flexsearch": "^0.8.212",
    "smol-toml": "^1.9.1",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/write-file-atomic": "^4.0.3",
    "astro": "^7.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "echarts": "^6.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "cl.seia.comunidades",
    "productName": "SEIA Comunidades",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
